{
  "name": "dsh-mysql-studio",
  "version": "0.6.0",
  "description": "DSH MySQL Studio：DataGrip 风格的 MySQL 连接管理、对象浏览、表数据网格、行改动提交、SQL 控制台与建库建表，接入 DSH 原生右侧栏 / dsh-better-sidebar。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mysql",
    "database",
    "datagrip",
    "sidebar",
    "dsh-plugin"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:sandboxed": "node --test --test-isolation=none \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "mysql2": "3.24.4"
  }
}
